# Copy to .env. Everything here is OPTIONAL — the stack runs without any of it.

# ── Required only for live One Health briefs ──────────────────────
# Without it the brief falls back to the deterministic template. Still a brief,
# just not a generated one. Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# ── Optional data sources ─────────────────────────────────────────
# Free tier, 1000 calls/day. openweathermap.org/api  (activation takes ~2h)
OPENWEATHER_API_KEY=
# Free. docs.openaq.org — v3 requires a key
OPENAQ_API_KEY=

# ── Infrastructure ────────────────────────────────────────────────
STORE_BACKEND=mock
# PostgreSQL and Redis are optional infrastructure profiles. The current build
# deliberately rejects STORE_BACKEND=postgres instead of falsely reporting a
# database connection that is not active.
DATABASE_URL=postgresql+psycopg://aqua:aqua@localhost:5432/aquasentinel
REDIS_URL=redis://localhost:6379/0
BRIEF_MODEL=claude-sonnet-4-6
